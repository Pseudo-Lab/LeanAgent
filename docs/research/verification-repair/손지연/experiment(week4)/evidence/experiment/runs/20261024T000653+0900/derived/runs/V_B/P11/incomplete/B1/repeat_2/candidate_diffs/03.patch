+
+  have eval_sum (z : L) {α : Type} [DecidableEq α]
+      (s : Finset α) (g : α → L[X]) :
+      Polynomial.eval z (∑ a in s, g a) =
+        ∑ a in s, Polynomial.eval z (g a) := by
+    induction s using Finset.induction_on with
+    | empty => simp
+    | @insert a s ha ih => simp [ha, ih]
+
+  have eval_prod (z : L) {α : Type} [DecidableEq α]
+      (s : Finset α) (g : α → L[X]) :
+      Polynomial.eval z (∏ a in s, g a) =
+        ∏ a in s, Polynomial.eval z (g a) := by
+    induction s using Finset.induction_on with
+    | empty => simp
+    | @insert a s ha ih => simp [ha, ih]
+
+  have hsub : ℓ - i.val = (ℓ - (i.val + 1)) + 1 := by omega
+  have hpow :
+      2 ^ (ℓ - i.val) = 2 ^ (ℓ - (i.val + 1)) * 2 := by
+    rw [hsub, pow_succ]
+
+  let pairEquiv :
+      Fin (2 ^ (ℓ - (i.val + 1))) × Fin 2 ≃
+        Fin (2 ^ (ℓ - i.val)) :=
+    { toFun := fun p =>
+        ⟨p.1.val * 2 + p.2.val, by
+          rw [hpow]
+          omega⟩
+      invFun := fun k =>
+        (⟨k.val / 2, by
+            have hk := k.isLt
+            rw [hpow] at hk
+            apply Nat.div_lt_of_lt_mul
+            omega⟩,
+         ⟨k.val % 2, Nat.mod_lt _ (by omega)⟩)
+      left_inv := by
+        rintro ⟨a, b⟩
+        apply Prod.ext
+        · apply Fin.ext
+          dsimp
+          omega
+        · apply Fin.ext
+          dsimp
+          omega
+      right_inv := by
+        intro k
+        apply Fin.ext
+        dsimp
+        omega }
+
+  have sum_even_odd (g : Fin (2 ^ (ℓ - i.val)) → L) :
+      (∑ k, g k) =
+        ∑ j : Fin (2 ^ (ℓ - (i.val + 1))),
+          g ⟨j.val * 2, by
+            rw [hpow]
+            omega⟩ +
+          g ⟨j.val * 2 + 1, by
+            rw [hpow]
+            omega⟩ := by
+    calc
+      (∑ k, g k) = ∑ p, g (pairEquiv p) :=
+        (pairEquiv.sum_comp g).symm
+      _ = _ := by
+        rw [Fintype.sum_prod_type]
+        simp [pairEquiv, Fin.sum_univ_two]
+
+  let tailEquiv : Fin ((ℓ - (i.val + 1)) + 1) ≃ Fin (ℓ - i.val) :=
+    Fin.cast hsub.symm
+
+  have prod_head_tail (g : Fin (ℓ - i.val) → L) :
+      (∏ k, g k) =
+        g ⟨0, by omega⟩ *
+          ∏ j : Fin (ℓ - (i.val + 1)), g ⟨j.val + 1, by omega⟩ := by
+    calc
+      (∏ k, g k) = ∏ k, g (tailEquiv k) :=
+        (tailEquiv.prod_comp g).symm
+      _ = _ := by
+        rw [Fin.prod_univ_succ]
+        simp [tailEquiv]
