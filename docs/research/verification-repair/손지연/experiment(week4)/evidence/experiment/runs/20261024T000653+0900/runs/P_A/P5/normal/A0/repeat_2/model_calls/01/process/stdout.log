{"type":"item.completed","item":{"id":"item_0","type":"agent_message","text":"{\"diagnosis\":\"The proof is correct but repeatedly re-elaborates finite smoothness downgrades and the Maxwell consequence of `h`. Cache those facts once while retaining the stable calculation chain.\",\"proof_body\":\"by\\n  have hAfin : ∀ n, ContDiff ℝ n A := fun _ => hA.of_le (by simp)\\n  have hJ' : Differentiable ℝ J := hJ.differentiable (by simp)\\n  have hMax := (isExtrema_iff_gauss_ampere_magneticFieldMatrix hA J hJ).mp h\\n  have hEs : ∀ j, ContDiff ℝ 2 (fun y => A.electricField 𝓕.c t y j) :=\\n    fun j => electricField_apply_contDiff_space (i := j) (hAfin _) t\\n  have hEd : ∀ j k, Differentiable ℝ (∂[k] (fun y => A.electricField 𝓕.c t y j)) :=\\n    fun j k => Space.deriv_differentiable (hEs j) k\\n  have hBt : ∀ j, Differentiable ℝ\\n      (fun s => ∂[j] (fun y => A.magneticFieldMatrix 𝓕.c s y (j, i)) x) :=\\n    fun j => Space.space_deriv_differentiable_time (i := j)\\n      (magneticFieldMatrix_contDiff _ (hAfin _) (j, i)) x\\n  have hJt : Differentiable ℝ (fun s => J.currentDensity 𝓕.c s x i) :=\\n    LorentzCurrentDensity.currentDensity_apply_differentiable_time hJ' x i\\n  calc\\n    _ = ∂ₜ (fun s =>\\n        1 / (𝓕.μ₀ * 𝓕.ε₀) * ∑ j,\\n          Space.deriv j (fun y => A.magneticFieldMatrix 𝓕.c s y (j, i)) x -\\n        1 / 𝓕.ε₀ * J.currentDensity 𝓕.c s x i) t := by\\n      conv_lhs =>\\n        enter [1]\\n        change fun s => ∂ₜ (A.electricField 𝓕.c · x i) s\\n        enter [s]\\n        rw [Time.deriv_euclid (electricField_differentiable_time (hAfin _) _),\\n          time_deriv_electricField_of_isExtrema hA J hJ h]\\n    _ = 1 / (𝓕.μ₀ * 𝓕.ε₀) *\\n          ∂ₜ (fun s => ∑ j, ∂[j] (A.magneticFieldMatrix 𝓕.c s · (j, i)) x) t -\\n        1 / 𝓕.ε₀ * ∂ₜ (J.currentDensity 𝓕.c · x i) t := by\\n      rw [Time.deriv_eq, fderiv_fun_sub]\\n      simp only [one_div, mul_inv_rev, FunLike.coe_sub, Pi.sub_apply]\\n      rw [fderiv_const_mul\\n          (Differentiable.fun_sum fun j _ => hBt j).differentiableAt,\\n        fderiv_const_mul hJt.differentiableAt]\\n      simp [Time.deriv_eq]\\n      · exact ((Differentiable.fun_sum fun j _ => hBt j).const_mul _).differentiableAt\\n      · exact hJt.differentiableAt.const_mul _\\n    _ = 1 / (𝓕.μ₀ * 𝓕.ε₀) *\\n          ((∑ j, ∂ₜ (fun s => ∂[j]\\n            (A.magneticFieldMatrix 𝓕.c s · (j, i)) x)) t) -\\n        1 / 𝓕.ε₀ * ∂ₜ (J.currentDensity 𝓕.c · x i) t := by\\n      congr\\n      rw [Time.deriv_eq]\\n      rw [fderiv_fun_sum fun j _ => (hBt j).differentiableAt]\\n      simp only [FunLike.coe_sum, Finset.sum_apply]\\n      rfl\\n    _ = 1 / (𝓕.μ₀ * 𝓕.ε₀) *\\n          (∑ j, ∂[j] (fun y => ∂ₜ\\n            (A.magneticFieldMatrix 𝓕.c · y (j, i)) t) x) -\\n        1 / 𝓕.ε₀ * ∂ₜ (J.currentDensity 𝓕.c · x i) t := by\\n      congr\\n      simp only [Finset.sum_apply]\\n      congr\\n      funext j\\n      rw [Space.time_deriv_comm_space_deriv]\\n      exact magneticFieldMatrix_contDiff _ (hAfin _) (j, i)\\n    _ = 1 / (𝓕.μ₀ * 𝓕.ε₀) *\\n          (∑ j, ∂[j] (fun y =>\\n            ∂[j] (A.electricField 𝓕.c t · i) y -\\n            ∂[i] (A.electricField 𝓕.c t · j) y) x) -\\n        1 / 𝓕.ε₀ * ∂ₜ (J.currentDensity 𝓕.c · x i) t := by\\n      congr\\n      simp only [Finset.sum_apply]\\n      congr\\n      funext j\\n      congr\\n      funext y\\n      rw [time_deriv_magneticFieldMatrix _ (hAfin _)]\\n    _ = 1 / (𝓕.μ₀ * 𝓕.ε₀) *\\n          ∑ j, (∂[j] (fun y => ∂[j]\\n              (A.electricField 𝓕.c t · i) y) x -\\n            ∂[j] (fun y => ∂[i]\\n              (A.electricField 𝓕.c t · j) y) x) -\\n        1 / 𝓕.ε₀ * ∂ₜ (J.currentDensity 𝓕.c · x i) t := by\\n      congr\\n      simp only [Finset.sum_apply]\\n      congr\\n      funext j\\n      rw [Space.deriv_eq_fderiv_basis]\\n      rw [fderiv_fun_sub (hEd _ _).differentiableAt\\n        (hEd _ _).differentiableAt]\\n      simp [← Space.deriv_eq_fderiv_basis]\\n    _ = 1 / (𝓕.μ₀ * 𝓕.ε₀) *\\n          ∑ j, ∂[j] (fun y => ∂[j]\\n            (A.electricField 𝓕.c t · i) y) x -\\n        1 / (𝓕.μ₀ * 𝓕.ε₀) *\\n          ∑ j, ∂[j] (fun y => ∂[i]\\n            (A.electricField 𝓕.c t · j) y) x -\\n        1 / 𝓕.ε₀ * ∂ₜ (J.currentDensity 𝓕.c · x i) t := by\\n      simp [mul_sub]\\n    _ = 1 / (𝓕.μ₀ * 𝓕.ε₀) *\\n          ∑ j, ∂[j] (fun y => ∂[j]\\n            (A.electricField 𝓕.c t · i) y) x -\\n        1 / (𝓕.μ₀ * 𝓕.ε₀) *\\n          ∑ j, ∂[i] (fun y => ∂[j]\\n            (A.electricField 𝓕.c t · j) y) x -\\n        1 / 𝓕.ε₀ * ∂ₜ (J.currentDensity 𝓕.c · x i) t := by\\n      congr\\n      funext j\\n      rw [Space.deriv_commute _ (hEs _), Space.deriv_eq_fderiv_basis]\\n    _ = 1 / (𝓕.μ₀ * 𝓕.ε₀) *\\n          ∑ j, ∂[j] (fun y => ∂[j]\\n            (A.electricField 𝓕.c t · i) y) x -\\n        1 / (𝓕.μ₀ * 𝓕.ε₀) *\\n          ∂[i] (fun y => ∑ j, ∂[j]\\n            (A.electricField 𝓕.c t · j) y) x -\\n        1 / 𝓕.ε₀ * ∂ₜ (J.currentDensity 𝓕.c · x i) t := by\\n      congr\\n      rw [Space.deriv_eq_fderiv_basis]\\n      rw [fderiv_fun_sum]\\n      simp [← Space.deriv_eq_fderiv_basis]\\n      intro j _\\n      exact (hEd j j).differentiableAt\\n    _ = 1 / (𝓕.μ₀ * 𝓕.ε₀) *\\n          ∑ j, ∂[j] (fun y => ∂[j]\\n            (A.electricField 𝓕.c t · i) y) x -\\n        1 / (𝓕.μ₀ * 𝓕.ε₀) *\\n          ∂[i] (fun y => (∇ ⬝ A.electricField 𝓕.c t) y) x -\\n        1 / 𝓕.ε₀ * ∂ₜ (J.currentDensity 𝓕.c · x i) t := by\\n      rfl\\n    _ = 1 / (𝓕.μ₀ * 𝓕.ε₀) *\\n          ∑ j, ∂[j] (∂[j] (A.electricField 𝓕.c t · i)) x -\\n        1 / (𝓕.μ₀ * 𝓕.ε₀ ^ 2) *\\n          ∂[i] (J.chargeDensity 𝓕.c t ·) x -\\n        1 / 𝓕.ε₀ * ∂ₜ (J.currentDensity 𝓕.c · x i) t := by\\n      congr 2\\n      conv_lhs =>\\n        enter [2, 2, y]\\n        rw [(hMax t y).1]\\n      trans 1 / (𝓕.μ₀ * 𝓕.ε₀) *\\n          ∂[i] (fun y => (1 / 𝓕.ε₀) * J.chargeDensity 𝓕.c t y) x\\n      · congr\\n        funext y\\n        ring\\n      · rw [Space.deriv_eq_fderiv_basis]\\n        rw [fderiv_const_mul]\\n        simp [← Space.deriv_eq_fderiv_basis]\\n        field_simp\\n        exact (LorentzCurrentDensity.chargeDensity_differentiable_space hJ' t).differentiableAt\\n    _ = 𝓕.c ^ 2 * ∑ j,\\n          ∂[j] (∂[j] (A.electricField 𝓕.c t · i)) x -\\n        𝓕.c ^ 2 / 𝓕.ε₀ * ∂[i] (J.chargeDensity 𝓕.c t ·) x -\\n        𝓕.c ^ 2 * 𝓕.μ₀ *\\n          ∂ₜ (J.currentDensity 𝓕.c · x i) t := by\\n      simp [FreeSpace.c_sq]\\n      field_simp\"}"}}
