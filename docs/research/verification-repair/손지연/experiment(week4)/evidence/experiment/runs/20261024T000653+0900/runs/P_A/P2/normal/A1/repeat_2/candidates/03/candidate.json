  "body": "by\n  intros Hnorm\n  have append_mono : ∀ {a b c d : List Expression.Ident},\n      a.Subset c → b.Subset d → (a ++ b).Subset (c ++ d) := by\n    intros a b c d Hac Hbd x Hx\n    simp only [List.mem_append] at Hx ⊢\n    exact Hx.elim (fun H => Or.inl (Hac H)) (fun H => Or.inr (Hbd H))\n  induction post <;>\n    simp [Imperative.HasVarsPure.getVars, extractOldExprVars,\n          Lambda.LExpr.LExpr.getVars] at * <;>\n    try simp_all\n  case app fn e fn_ih e_ih =>\n    unfold extractOldExprVars\n    split\n    · simp [Lambda.LExpr.LExpr.getVars]\n      intros x Hin\n      exact Hin\n    · next Hfalse =>\n      cases Hnorm with\n      | app H1 H2 Hn =>\n        exfalso\n        specialize Hn ?_\n        constructor\n        cases Hn\n        apply Hfalse\n        rfl\n    · cases Hnorm with\n      | app H1 H2 Hn =>\n        apply append_mono\n        · exact fn_ih H1\n        · exact e_ih H2\n  case abs ih =>\n    cases Hnorm\n    apply ih\n    assumption\n  case quant trih eih =>\n    cases Hnorm\n    apply append_mono\n    · apply trih\n      assumption\n    · apply eih\n      assumption\n  case ite cih tih eih =>\n    cases Hnorm\n    apply append_mono\n    · apply cih\n      assumption\n    · apply append_mono\n      · apply tih\n        assumption\n      · apply eih\n        assumption\n  case eq ih1 ih2 =>\n    cases Hnorm\n    apply append_mono\n    · apply ih1\n      assumption\n    · apply ih2\n      assumption",
