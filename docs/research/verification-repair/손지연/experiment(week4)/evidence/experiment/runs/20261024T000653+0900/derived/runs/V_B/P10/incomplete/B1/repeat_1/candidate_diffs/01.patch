+  rcases Nat.sInf_mem hS_nonempty with ⟨g, _, hg_min⟩
+  have hg_min_dist :
+      (fiberwiseDisagreementSet 𝔽q β i steps h_i_add_steps f g).ncard =
+        fiberwiseDistance 𝔽q β (h_ℓ_add_R_rate := h_ℓ_add_R_rate)
