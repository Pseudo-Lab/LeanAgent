+    calc
+      2 ^ Fintype.card S = 2 ^ ((Fintype.card S - 1) + 1) := by
+        congr 1
+        omega
+      _ = 2 ^ (Fintype.card S - 1) * 2 := by rw [pow_succ]
+      _ = 2 ^ (Fintype.card S - 1) + 2 ^ (Fintype.card S - 1) := by omega
